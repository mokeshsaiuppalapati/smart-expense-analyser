<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="root" alignment="CENTER" spacing="20" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expense.ui.SplashController">
    <children>
        <FontIcon iconLiteral="mdi2c-chart-line" iconSize="64" styleClass="glyph-icon" style="-fx-fill: #3498db;" />
        <Label style="-fx-font-size: 24px; -fx-text-fill: white;" text="Smart Expense Analyser" />
        <ProgressIndicator />

        <Label fx:id="statusLabel" style="-fx-text-fill: #bdc3c7;" text="Loading..." />

    </children>
</VBox>